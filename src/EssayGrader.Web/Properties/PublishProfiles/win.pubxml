<?xml version="1.0" encoding="utf-8"?>
<!--
  单文件自包含 exe 发布配置（Windows x64，无需安装 .NET 运行时）。
  用法：dotnet publish src/EssayGrader.Web/EssayGrader.Web.csproj -c Release -p:PublishProfile=win
  产物：bin/Release/net8.0/win-x64/publish/EssayGrader.Web.exe（单个可执行文件）
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin/Release/net8.0/win-x64/publish/</PublishDir>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>