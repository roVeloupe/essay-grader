<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EssayGrader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EssayGrader.App.ViewModels"
    mc:Ignorable="d"
    Title="高中作文 AI 批改系统">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="12,0">
                <TextBlock Text="高中作文 AI 批改系统" VerticalAlignment="Center"
                           FontSize="13" Opacity="0.75"/>
            </Grid>
        </Border>

        <!-- 三栏主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ① 左导航（仿微信电脑版最左侧图标栏） -->
            <Border Grid.Column="0" Background="#2E2E2E">
                <StackPanel Spacing="6" Margin="0,14,0,0">
                    <RadioButton IsChecked="True" Style="{StaticResource RadioButtonStyle}">
                        <RadioButton.Template><ControlTemplate>
                            <Grid Width="52" Height="44" Background="Transparent" CornerRadius="8">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="18" Foreground="White"/>
                                    <TextBlock Text="批阅" FontSize="10" Foreground="White"/>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate></RadioButton.Template>
                    </RadioButton>
                    <Grid Width="52" Height="44" Background="Transparent" CornerRadius="8">
                        <StackPanel Spacing="2"><FontIcon Glyph="&#xE9D2;" FontSize="18" Foreground="#B9BCC2"/><TextBlock Text="标准" FontSize="10" Foreground="#B9BCC2"/></StackPanel>
                    </Grid>
                    <Grid Width="52" Height="44" Background="Transparent" CornerRadius="8">
                        <StackPanel Spacing="2"><FontIcon Glyph="&#xE7C7;" FontSize="18" Foreground="#B9BCC2"/><TextBlock Text="记录" FontSize="10" Foreground="#B9BCC2"/></StackPanel>
                    </Grid>
                    <Grid Width="52" Height="44" Background="Transparent" CornerRadius="8">
                        <StackPanel Spacing="2"><FontIcon Glyph="&#xE904;" FontSize="18" Foreground="#B9BCC2"/><TextBlock Text="引擎" FontSize="10" Foreground="#B9BCC2"/></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ② 中部：搜索 + 导入 + 作文列表（按文件名排序） -->
            <Grid Grid.Column="1" Background="#ECECEC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Spacing="8" Padding="12">
                    <TextBox Width="240" PlaceholderText="搜索文件名 / 学生姓名" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="⬆ 导入图片" Click="OnImportClick" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="批量批阅" Click="OnBatchClick"/>
                    </StackPanel>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="EssayList" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EssayListItem">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="6" Background="{x:Bind Color}">
                                    <TextBlock Text="{x:Bind Initial}" FontSize="16" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Summary}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind StatusText}" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ③ 右侧内容区 -->
            <Grid Grid.Column="2" Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="18,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="尚未选择作文" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HeaderMeta" Text="" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Pivot Grid.Row="1" x:Name="ContentPivot" Margin="8,0">
                    <PivotItem Header="识别">
                        <TextBox x:Name="RecognizedText" AcceptsReturn="True" IsReadOnly="True"
                                 TextWrapping="Wrap" FontSize="14" Padding="12" HorizontalAlignment="Stretch"/>
                    </PivotItem>
                    <PivotItem Header="校对">
                        <TextBlock Text="逐句比对 / 原图复核（开发文档 §7）。校对通过后进入批阅。"
                                   TextWrapping="Wrap" Margin="16" Opacity="0.7" VerticalAlignment="Top"/>
                    </PivotItem>
                    <PivotItem Header="批阅结果">
                        <TextBlock Text="总分、优点、缺点、修改建议（开发文档 §8/§9）。"
                                   TextWrapping="Wrap" Margin="16" Opacity="0.7" VerticalAlignment="Top"/>
                    </PivotItem>
                </Pivot>
                <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Padding="12">
                        <TextBlock x:Name="ProgressText" Text="" VerticalAlignment="Center" Opacity="0.6" FontSize="12"/>
                        <Button Content="识别并校对" Click="OnRunClick"/>
                        <Button Content="按标准批阅" Click="OnGradeClick" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="导出报告" Click="OnExportClick"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>